---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base title="Page not found — Ahmed Albadri" description="This page does not exist.">
  <section class="mx-auto max-w-container px-6 py-32 text-center lg:px-8">
    <p class="font-display text-5xl text-bronze-300">404</p>
    <h1 class="mt-6 font-display text-2xl">This page is off the map.</h1>
    <p lang="ar" dir="rtl" class="mt-2 text-lg text-bronze-700">هذه الصفحة غير موجودة</p>
    <div class="mt-12 flex justify-center gap-4">
      <Button href="/">Back home</Button>
      <Button href="/work" variant="ghost">View the work</Button>
    </div>
  </section>
</Base>
