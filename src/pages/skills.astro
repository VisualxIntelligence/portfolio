---
import Base from '../layouts/Base.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import Tag from '../components/Tag.astro';
import { getSkills } from '../lib/data';

const skills = await getSkills();
---

<Base
  title="Agentic Skills — Ahmed Albadri"
  description="Claude skills and agents built by Ahmed Albadri — what each one automates, the stack behind it, and proof it runs."
>
  <section class="mx-auto max-w-container px-6 pb-24 pt-16 lg:px-8">
    <header class="hero-fade mb-16 max-w-prose">
      <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
        <h1 class="font-display text-3xl md:text-4xl">Agentic Skills</h1>
        <span lang="ar" dir="rtl" class="text-xl text-bronze-500">مهارات وكيلة</span>
      </div>
      <p class="mt-6 text-lg text-ink-2">
        AI-first means building the tools, not just using them. These are Claude skills and agents
        I run in my own workflow — each listed with exactly what it automates and the stack behind
        it.
      </p>
    </header>

    <div class="space-y-16">
      {
        skills.map((skill) => (
          <article
            class="reveal grid gap-8 rounded-md border border-line bg-paper-2 p-6 md:grid-cols-[1.1fr,1fr] md:p-8"
            aria-labelledby={`skill-${skill.slug}`}
          >
            <div>
              <div class="flex flex-wrap items-center gap-3">
                <h2 id={`skill-${skill.slug}`} class="font-display text-xl">
                  {skill.name}
                </h2>
                <span
                  class:list={[
                    'rounded-full px-3 py-1 text-xs font-medium',
                    skill.status === 'in use'
                      ? 'bg-success/10 text-success ring-1 ring-success/40'
                      : 'bg-paper text-ink-2 ring-1 ring-line',
                  ]}
                >
                  {skill.status === 'in use' ? 'In daily use' : 'Prototype'}
                </span>
              </div>
              <p class="mt-3 text-lg text-ink-2">{skill.oneLiner}</p>
              <h3 class="mt-6 text-xs font-medium uppercase tracking-lockup text-neutral-500">
                What it automates
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-2">{skill.whatItAutomates}</p>
              {skill.stack?.length ? (
                <div class="mt-6 flex flex-wrap gap-2">
                  {skill.stack.map((s) => (
                    <Tag>{s}</Tag>
                  ))}
                </div>
              ) : null}
              {skill.repoOrLink && (
                <a
                  href={skill.repoOrLink}
                  rel="noopener"
                  class="link-underline mt-6 inline-block text-sm font-medium text-bronze-700"
                >
                  View repo / live link
                </a>
              )}
            </div>
            <div>
              {skill.demoVideoUrl ? (
                <VideoEmbed url={skill.demoVideoUrl} title={`Demo: ${skill.name}`} />
              ) : skill.screenshots?.length ? (
                <img
                  src={skill.screenshots[0].src}
                  alt={skill.screenshots[0].alt}
                  width={skill.screenshots[0].width ?? 1200}
                  height={skill.screenshots[0].height ?? 750}
                  loading="lazy"
                  decoding="async"
                  class="w-full rounded-md border border-line object-cover"
                />
              ) : (
                <div class="grid aspect-video place-items-center rounded-md border border-dashed border-line text-sm text-neutral-500">
                  Demo recording coming soon
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Base>
