---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  class?: string;
}
const { href, variant = 'primary', class: className = '' } = Astro.props;
---

<a
  {href}
  class:list={[
    'inline-flex items-center gap-2 rounded-sm px-6 py-3 font-display text-sm font-medium uppercase tracking-lockup transition-colors duration-hover ease-editorial',
    variant === 'primary'
      ? 'bg-ink text-paper hover:bg-bronze-700'
      : 'border border-ink text-ink hover:border-bronze-500 hover:text-bronze-700',
    className,
  ]}
>
  <slot />
  <span aria-hidden="true">→</span>
</a>
