---
/** Downloadable documents (reports, decks, PDFs) attached to a case study.
 *  Each row offers Download (forced via ?dl= for cross-origin Sanity files) and
 *  Open (native browser viewer, new tab). */
import type { ProjectDocument } from '../lib/types';

interface Props {
  documents: ProjectDocument[];
}
const { documents } = Astro.props;

function humanSize(size?: number): string {
  if (!size) return '';
  const kb = size / 1024;
  return kb < 1024 ? `${Math.max(1, Math.round(kb))} KB` : `${(kb / 1024).toFixed(1)} MB`;
}

function fileName(d: ProjectDocument): string {
  const base = d.title.replace(/[^\w-]+/g, '-').replace(/^-+|-+$/g, '') || 'document';
  return d.ext ? `${base}.${d.ext}` : base;
}

// Same-origin (seed) files download via the attribute; cross-origin Sanity CDN
// files need the ?dl= param since the download attribute is ignored there.
function downloadHref(d: ProjectDocument): string {
  return d.url.startsWith('http') ? `${d.url}?dl=${encodeURIComponent(fileName(d))}` : d.url;
}
---

<ul class="grid gap-4 sm:grid-cols-2">
  {
    documents.map((d) => (
      <li class="reveal">
        <div class="flex h-full items-start gap-4 rounded-md border border-line bg-paper-2 p-5">
          <span
            aria-hidden="true"
            class="grid h-12 w-10 shrink-0 place-items-center rounded-sm border border-bronze-300 bg-paper font-display text-[0.6rem] font-bold tracking-wide text-bronze-700"
          >
            {(d.ext ?? 'DOC').toUpperCase().slice(0, 4)}
          </span>
          <div class="min-w-0 flex-1">
            <h3 class="font-display text-lg leading-snug">{d.title}</h3>
            {(d.kind || d.size) && (
              <p class="mt-1 text-xs text-neutral-500">
                {[d.kind, humanSize(d.size)].filter(Boolean).join(' · ')}
              </p>
            )}
            <div class="mt-3 flex flex-wrap gap-4">
              <a
                href={downloadHref(d)}
                download
                class="link-underline text-sm font-medium text-bronze-700"
              >
                Download
              </a>
              <a
                href={d.url}
                target="_blank"
                rel="noopener"
                class="link-underline text-sm font-medium text-bronze-700"
              >
                Open
              </a>
            </div>
          </div>
        </div>
      </li>
    ))
  }
</ul>
