---
/** Verbatim prompt excerpt, typeset like a quoted source document. */
interface Props {
  text: string;
  index?: number;
}
const { text, index } = Astro.props;
---

<figure class="reveal rounded-md border border-line bg-paper-2 p-6">
  <figcaption class="mb-3 flex items-center gap-3 text-xs font-medium uppercase tracking-lockup text-bronze-700">
    <span class="h-px w-6 bg-bronze-500" aria-hidden="true"></span>
    Prompt excerpt{typeof index === 'number' ? ` ${String(index + 1).padStart(2, '0')}` : ''}
  </figcaption>
  <blockquote class="font-mono text-sm leading-relaxed text-ink-2">{text}</blockquote>
</figure>
