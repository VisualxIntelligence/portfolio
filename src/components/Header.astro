---
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/ai-lab', label: 'AI Lab' },
  { href: '/skills', label: 'Skills' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));
---

<header class="hairline sticky top-0 z-40 bg-paper/95 backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-container items-center justify-between px-6 lg:px-8">
    <a href="/" class="group flex items-baseline gap-3" aria-label="Ahmed Albadri — home">
      <span
        aria-hidden="true"
        class="grid h-8 w-8 place-items-center border border-ink font-display text-sm font-bold tracking-lockup transition-colors duration-hover ease-editorial group-hover:border-bronze-500 group-hover:text-bronze-700"
        >AA</span
      >
      <span class="font-display text-sm font-500 uppercase tracking-lockup">Ahmed Albadri</span>
      <span lang="ar" dir="rtl" class="hidden text-sm text-bronze-700 sm:inline">أحمد البدري</span>
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-8">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={[
                  'link-underline text-sm font-medium transition-colors duration-hover ease-editorial hover:text-bronze-700',
                  isCurrent(item.href) ? 'text-bronze-700' : 'text-ink',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="grid h-10 w-10 place-items-center md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <span class="relative block h-3 w-6">
        <span class="menu-bar absolute inset-x-0 top-0 h-px bg-ink transition-transform duration-hover ease-editorial"></span>
        <span class="menu-bar absolute inset-x-0 bottom-0 h-px bg-ink transition-transform duration-hover ease-editorial"></span>
      </span>
    </button>
  </div>

  <div id="mobile-menu" hidden class="hairline border-t border-line bg-paper md:hidden">
    <nav aria-label="Mobile">
      <ul class="space-y-1 px-6 py-6">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={[
                  'block py-2 font-display text-xl',
                  isCurrent(item.href) ? 'text-bronze-700' : 'text-ink',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (menu) menu.hidden = open;
    toggle.classList.toggle('is-open', !open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      toggle.click();
      toggle.focus();
    }
  });
</script>

<style>
  #menu-toggle.is-open .menu-bar:first-child {
    transform: translateY(5.5px) rotate(45deg);
  }
  #menu-toggle.is-open .menu-bar:last-child {
    transform: translateY(-5.5px) rotate(-45deg);
  }
</style>
