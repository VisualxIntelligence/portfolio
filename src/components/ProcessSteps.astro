---
/** AI Lab process documentation: brief → prompts → consistency → QC (spec §3.3). */
import type { ProcessStep } from '../lib/types';

interface Props {
  steps: ProcessStep[];
}
const { steps } = Astro.props;
---

<ol class="space-y-12">
  {
    steps.map((step, i) => (
      <li class="reveal grid items-start gap-6 md:grid-cols-[1fr,1.2fr] md:gap-12">
        <div>
          <span class="font-display text-4xl text-bronze-300">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-2 font-display text-xl">{step.step.replace(/^\d+\s*[—-]\s*/, '')}</h3>
          {step.description && <p class="mt-3 max-w-prose text-ink-2">{step.description}</p>}
        </div>
        {step.image && (
          <img
            src={step.image.src}
            alt={step.image.alt}
            width={step.image.width ?? 1200}
            height={step.image.height ?? 750}
            loading="lazy"
            decoding="async"
            class="w-full rounded-md border border-line object-cover"
          />
        )}
      </li>
    ))
  }
</ol>
