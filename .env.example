# Sanity — create a project at sanity.io/manage, then copy the values here (as .env).
# Until these are set, the site builds from the local seed content in src/lib/seed.ts
# and the /admin studio route is disabled.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Canonical site URL (used for sitemap + OG tags)
PUBLIC_SITE_URL=https://ahmedalbadri.vercel.app
